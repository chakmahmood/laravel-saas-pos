# Frontend environment (Vite).
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets (API keys, DB credentials) here.

# Base URL of the Laravel API. Must include the /api prefix.
VITE_API_BASE_URL=http://localhost:8000/api

# Displayed application name (optional).
VITE_APP_NAME="SaaS POS"
